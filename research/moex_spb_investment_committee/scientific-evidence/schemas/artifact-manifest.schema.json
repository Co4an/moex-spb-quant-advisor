{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Evidence Artifact Manifest",
  "type": "object",
  "required": [
    "schema_name",
    "artifact",
    "derived_from"
  ],
  "properties": {
    "schema_name": {
      "const": "scientific-evidence.artifact-manifest"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_by": {
      "type": "object",
      "required": [
        "script_path"
      ],
      "properties": {
        "script_path": {
          "type": "string",
          "minLength": 1
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
