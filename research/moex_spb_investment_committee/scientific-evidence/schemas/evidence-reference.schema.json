{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Evidence Reference",
  "type": "object",
  "required": [
    "schema_name",
    "raw",
    "target",
    "target_kind"
  ],
  "properties": {
    "schema_name": {
      "const": "scientific-evidence.evidence-reference"
    },
    "raw": {
      "type": "string",
      "pattern": "^@evidence\\[\\[[^\\]]+\\]\\]$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "path",
        "uri",
        "id",
        "unknown"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    }
  }
}
